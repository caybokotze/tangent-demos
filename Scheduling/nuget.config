<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    The demo consumes Tangent exactly as a user would: from packages, not project references.
    `local` is the repository's own package output (`dotnet pack Tangent.slnx -c Release`).
  -->
  <packageSources>
    <clear />
    <add key="local" value="../../tangent/artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
